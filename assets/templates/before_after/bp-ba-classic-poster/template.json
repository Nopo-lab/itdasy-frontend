{
  "templateId": "bp-ba-classic-poster",
  "handoffId": null,
  "displayName": "전후 · 클래식 포스터(리본)",
  "rendererFunctionName": "_skBaClassicPoster",
  "category": "beforeAfter",
  "ratio": "4:5",
  "canvas": {
    "width": 1080,
    "height": 1350
  },
  "tier": "free",
  "requiredPhotos": {
    "before": 1,
    "after": 1
  },
  "supportsMultiPair": true,
  "imageSlots": [
    {
      "id": "before_photo",
      "role": "before",
      "required": true,
      "crop": "cover",
      "appKey": "before_photo",
      "appSource": "state.secondImg"
    },
    {
      "id": "after_photo",
      "role": "after",
      "required": true,
      "crop": "cover",
      "appKey": "after_photo",
      "appSource": "_resolveAfter(state,tpl)"
    }
  ],
  "textLayers": [
    "brand_logo",
    "eyebrow",
    "title",
    "rule_line",
    "ribbon_before",
    "ribbon_after",
    "review_text",
    "customer_meta",
    "info_service",
    "info_shop",
    "cta_text"
  ],
  "editableSlots": [
    "shop_name",
    "headline",
    "subtitle",
    "before_label",
    "after_label",
    "before_caption",
    "after_caption",
    "cta",
    "service_name",
    "review_text",
    "customer_label"
  ],
  "defaultCopy": {
    "headline": "BEFORE & AFTER",
    "subtitle": "직접 경험한 변화, 잇데이에서 확인하세요.",
    "before_label": "BEFORE",
    "after_label": "AFTER",
    "service_name": "슈링크 유니버스 리프팅",
    "shop_name": "잇데이 청담점",
    "eyebrow": "전후 비교",
    "review_text": "피부결이 매끈해지고 전체적으로 생기가 돌았어요. 자연스럽게 예뻐져서 주변에서도 알아봐요!",
    "customer_label": "잇데이 회원 · 김서연님 · 29세",
    "cta": "전후 인증하기"
  },
  "appSlotMapping": {
    "title": {
      "appSlot": "headline",
      "dataField": "data.head"
    },
    "subtitle": {
      "appSlot": "subtitle",
      "dataField": "data.sub"
    },
    "service_name": {
      "appSlot": "service_name",
      "dataField": "data.serviceName"
    },
    "shop_name": {
      "appSlot": "shop_name",
      "dataField": "data.shop"
    },
    "review_text": {
      "appSlot": "review_text",
      "dataField": "data.review"
    },
    "customer_meta": {
      "appSlot": "customer_label",
      "dataField": "data.customer"
    },
    "cta_text": {
      "appSlot": "cta",
      "dataField": "data.cta"
    },
    "badge_before": {
      "appSlot": "before_label",
      "dataField": "data.beforeLabel"
    },
    "badge_after": {
      "appSlot": "after_label",
      "dataField": "data.afterLabel"
    },
    "before_photo": {
      "appSlot": "before_photo(image)",
      "dataField": "state.secondImg"
    },
    "after_photo": {
      "appSlot": "after_photo(image)",
      "dataField": "state.editedImg"
    }
  },
  "notes": "런타임 source of truth 아님. 실제 렌더는 template-renderer-beauty-pack-draws.js 의 rendererFunctionName 함수가 캔버스로 그린다. 편집 슬롯은 template-slots.js before_after base + template-pack-beauty-data.js extraSlots 에서 생성. PPTX 미포함."
}
