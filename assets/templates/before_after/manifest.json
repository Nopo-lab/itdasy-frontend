{
  "version": "20260623-v533-before-after-template-pack",
  "app": "itdasy",
  "packId": "before_after_editorial_pack_v533",
  "description": "5 editable before/after beauty templates for the Itdasy workspace. NOTE: 런타임 source of truth 가 아니라 레이어 매핑/핸드오프 문서. 실제 렌더는 캔버스 JS draw 함수(template-renderer-beauty-pack-draws.js)가, 데이터는 template-pack-beauty-data.js 가, 매핑은 premium-templates META 가 담당한다. PPTX 는 이번 작업에서 제외(앱이 PPTX 를 런타임에 읽지 않음).",
  "runtimeSourceOfTruth": false,
  "renderer": "window.PhotoEditorBeautyPack.draw (canvas, 1080x1350)",
  "appRegistry": {
    "data": "js/photo-editor/template-pack-beauty-data.js",
    "draws": "js/photo-editor/template-renderer-beauty-pack-draws.js",
    "metaMap": "js/photo-editor/premium-templates.js (META)",
    "workspaceGallery": "js/workspace/workspace-v2-flow.js (WORKSPACE_TEMPLATES)",
    "defaultTemplatePicker": "js/workspace/workspace-v2-home.js (CAT_TEMPLATES.ba)"
  },
  "globalLayerNamingRules": {
    "required": ["before_photo", "after_photo", "title", "service_name", "shop_name"],
    "recommended": ["subtitle", "badge_before", "badge_after", "review_text", "customer_meta", "cta_text"],
    "rule": "Layer IDs는 PPTX/JSON/렌더러/앱 슬롯에서 안정적으로 유지. 앱 슬롯 키 매핑은 각 template.json 의 appSlotMapping 참조."
  },
  "common": {
    "category": "beforeAfter",
    "ratio": "4:5",
    "canvas": { "width": 1080, "height": 1350 },
    "requiredPhotos": { "before": 1, "after": 1 },
    "supportsMultiPair": true,
    "defaultEligible": true,
    "tier": "free",
    "designTokens": { "brandRose": "#D58A95", "brandStrong": "#BC6675", "roseBg": "#F7EFF0", "appBg": "#F2F4F6", "cardSurface": "#FFFFFF", "text": "#191F28", "muted": "#6B7280", "line": "#E5E7EB" }
  },
  "templates": [
