    { "templateId": "bp-ba-luxury-review", "handoffId": "ba_luxury_review_02", "displayName": "전후 · 럭셔리 후기 포스터", "rendererFunctionName": "_skBaLuxuryReview", "templateJson": "assets/templates/before_after/bp-ba-luxury-review/template.json", "designFeature": "초대형 BEFORE&AFTER 타이포, 시술명/매장 정보행, 좌우 전후 사진, 큰 별점 후기 카드 중심, 하단 CTA(카메라)" },
    { "templateId": "bp-ba-story-signature", "handoffId": "ba_story_signature_03", "displayName": "전후 · 스토리 시그니처", "rendererFunctionName": "_skBaStorySignature", "templateJson": "assets/templates/before_after/bp-ba-story-signature/template.json", "designFeature": "한글 대제목 '시술 전후', 원형 변화 배지, 좌측 '이런 분께 추천' 리스트 + 우측 전후 사진 + 시술명/시간/회복 칩, 후기, CTA" },
    { "templateId": "bp-ba-classic-poster", "handoffId": "ba_classic_poster_04", "displayName": "전후 · 클래식 포스터(리본)", "rendererFunctionName": "_skBaClassicPoster", "templateJson": "assets/templates/before_after/bp-ba-classic-poster/template.json", "designFeature": "BEFORE&AFTER 세리프 + 룰 라인, 대각 리본 BEFORE/AFTER 라벨, 중앙 화살표, 인용 후기 박스, 시술명/지점 카드, 하단 CTA" },
    { "templateId": "bp-ba-care-guide", "handoffId": "ba_care_guide_05", "displayName": "전후 · 케어 가이드(정보형)", "rendererFunctionName": "_skBaCareGuide", "templateJson": "assets/templates/before_after/bp-ba-care-guide/template.json", "designFeature": "전후 사진 + 시술명/시술시간/회복기간 케어 정보카드, '이런 분께 추천' 칩, 별점 후기, 하단 CTA" }
  ]
}
